{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
	"target": "ES2022",
	"module": "CommonJS",
	"rootDir": "./tests",
	"outDir": "./dist/test-output",
	"esModuleInterop": true,
	"forceConsistentCasingInFileNames": true,
	"strict": true,
	"skipLibCheck": true
	},
	"include": [
	"tests/**/*.ts"
	],
	"exclude": [
	"node_modules",
	"src/worker/**"
	]
}